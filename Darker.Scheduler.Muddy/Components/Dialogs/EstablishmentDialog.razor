@using MudBlazor
@using Darker.Scheduler.Data.Models
@using Microsoft.AspNetCore.Components

@inject MudBlazor.IDialogService MudDialog

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@((Entity.Id == 0 ? "New" : "Edit") + " Establishment")</MudText>
        <MudTextField @bind-Value="Entity.Name" Label="Name" Variant="Variant.Outlined" Class="mb-2" />
        <MudSelect T="EstablishmentType" Label="Type" @bind-Value="Entity.Type" Variant="Variant.Outlined" Class="mb-2">
            <MudSelectItem Value="EstablishmentType.Bar">Bar</MudSelectItem>
            <MudSelectItem Value="EstablishmentType.Restaurant">Restaurant</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public Establishment Entity { get; set; } = new();

    [CascadingParameter] public required IMudDialogInstance MudDialogInstance { get; set; }

    void Submit()
    {
        MudDialogInstance.Close(DialogResult.Ok(Entity));
    }

    void Cancel()
    {
        MudDialogInstance.Cancel();
    }
}