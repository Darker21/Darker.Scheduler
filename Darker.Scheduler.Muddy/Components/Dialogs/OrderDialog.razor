@using MudBlazor
@using Darker.Scheduler.Data.Models
@inject MudBlazor.IDialogService MudDialog

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@((Entity.Id == 0 ? "New" : "Edit") + " Order")</MudText>
        <MudSelect T="int" Label="Schedule" @bind-Value="Entity.ScheduleId" Variant="Variant.Outlined" Class="mb-2">
            @if (Schedules != null)
            {
                @foreach (var sched in Schedules)
                {
                    <MudSelectItem Value="@sched.Id">@sched.CronExpression</MudSelectItem>
                }
            }
        </MudSelect>
        <MudTextField @bind-Value="Entity.Details" Label="Details (JSON/Text)" Variant="Variant.Outlined" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialogInstance { get; set; }

    [Parameter]
    public Order Entity { get; set; } = new();
    [Parameter]
    public List<Schedule> Schedules { get; set; } = new();

    void Submit()
    {
        Entity.CreatedAt = DateTime.Now;
        MudDialogInstance.Close(DialogResult.Ok(Entity));
    }

    void Cancel()
    {
        MudDialogInstance.Cancel();
    }
}
