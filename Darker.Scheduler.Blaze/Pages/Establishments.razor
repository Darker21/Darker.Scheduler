@page "/establishments"
@using Darker.Scheduler.Data.Context
@using Darker.Scheduler.Data.Models
@using Microsoft.EntityFrameworkCore
@inject SchedulerDbContext Db

<h3>Establishments</h3>

<button class="btn btn-primary mb-2" @onclick="ShowCreateModal">New Establishment</button>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Options</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var est in establishments)
        {
            <tr>
                <td>@est.Name</td>
                <td>@est.Type</td>
                <td>
                    <button class="btn btn-sm btn-secondary" @onclick="() => ShowEditModal(est)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => Delete(est.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (showModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((editEntity == null ? "New" : "Edit") + " Establishment")</h5>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Name</label>
                        <input class="form-control" @bind="modalEntity.Name" />
                    </div>
                    <div class="mb-3">
                        <label>Type</label>
                        <select class="form-control" @bind="modalEntity.Type">
                            <option value="Bar">Bar</option>
                            <option value="Restaurant">Restaurant</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="Save">Save</button>
                    <button class="btn btn-secondary" @onclick="HideModal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    List<Establishment> establishments = new();
    bool showModal = false;
    Establishment? editEntity;
    Establishment modalEntity = new();

    protected override async Task OnInitializedAsync()
    {
        establishments = await Db.Establishments.ToListAsync();
    }

    void ShowCreateModal()
    {
        editEntity = null;
        modalEntity = new Establishment();
        showModal = true;
    }

    void ShowEditModal(Establishment est)
    {
        editEntity = est;
        modalEntity = new Establishment { Id = est.Id, Name = est.Name, Type = est.Type };
        showModal = true;
    }

    async void Save()
    {
        if (editEntity == null)
        {
            Db.Establishments.Add(modalEntity);
        }
        else
        {
            var entity = await Db.Establishments.FindAsync(modalEntity.Id);
            if (entity != null)
            {
                entity.Name = modalEntity.Name;
                entity.Type = modalEntity.Type;
            }
        }
        await Db.SaveChangesAsync();
        establishments = await Db.Establishments.ToListAsync();
        HideModal();
        StateHasChanged();
    }

    async void Delete(int id)
    {
        var entity = await Db.Establishments.FindAsync(id);
        if (entity != null)
        {
            Db.Establishments.Remove(entity);
            await Db.SaveChangesAsync();
            establishments = await Db.Establishments.ToListAsync();
            StateHasChanged();
        }
    }

    void HideModal()
    {
        showModal = false;
    }
}
