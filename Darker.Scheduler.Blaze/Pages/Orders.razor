@page "/orders"
@using Darker.Scheduler.Data.Context
@using Darker.Scheduler.Data.Models
@using Microsoft.EntityFrameworkCore
@inject SchedulerDbContext Db

<h3>Orders</h3>

<button class="btn btn-primary mb-2" @onclick="ShowCreateModal">New Order</button>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Schedule</th>
            <th>Created At</th>
            <th>Details</th>
            <th>Options</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in orders)
        {
            <tr>
                <td>@order.Schedule?.CronExpression</td>
                <td>@order.CreatedAt.ToString("g")</td>
                <td>@order.Details</td>
                <td>
                    <button class="btn btn-sm btn-secondary" @onclick="() => ShowEditModal(order)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => Delete(order.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (showModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((editEntity == null ? "New" : "Edit") + " Order")</h5>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Schedule</label>
                        <select class="form-control" @bind="modalEntity.ScheduleId">
                            @foreach (var sched in schedules)
                            {
                                <option value="@sched.Id">@sched.CronExpression</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Details (JSON/Text)</label>
                        <textarea class="form-control" @bind="modalEntity.Details"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="Save">Save</button>
                    <button class="btn btn-secondary" @onclick="HideModal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    List<Order> orders = new();
    List<Schedule> schedules = new();
    bool showModal = false;
    Order? editEntity;
    Order modalEntity = new() { CreatedAt = DateTime.Now };

    protected override async Task OnInitializedAsync()
    {
        orders = await Db.Orders.Include(o => o.Schedule).ToListAsync();
        schedules = await Db.Schedules.ToListAsync();
    }

    void ShowCreateModal()
    {
        editEntity = null;
        modalEntity = new Order { CreatedAt = DateTime.Now };
        showModal = true;
    }

    void ShowEditModal(Order order)
    {
        editEntity = order;
        modalEntity = new Order {
            Id = order.Id,
            ScheduleId = order.ScheduleId,
            CreatedAt = order.CreatedAt,
            Details = order.Details
        };
        showModal = true;
    }

    async void Save()
    {
        if (editEntity == null)
        {
            Db.Orders.Add(modalEntity);
        }
        else
        {
            var entity = await Db.Orders.FindAsync(modalEntity.Id);
            if (entity != null)
            {
                entity.ScheduleId = modalEntity.ScheduleId;
                entity.CreatedAt = modalEntity.CreatedAt;
                entity.Details = modalEntity.Details;
            }
        }
        await Db.SaveChangesAsync();
        orders = await Db.Orders.Include(o => o.Schedule).ToListAsync();
        HideModal();
        StateHasChanged();
    }

    async void Delete(int id)
    {
        var entity = await Db.Orders.FindAsync(id);
        if (entity != null)
        {
            Db.Orders.Remove(entity);
            await Db.SaveChangesAsync();
            orders = await Db.Orders.Include(o => o.Schedule).ToListAsync();
            StateHasChanged();
        }
    }

    void HideModal()
    {
        showModal = false;
    }
}
